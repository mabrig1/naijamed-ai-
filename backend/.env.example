# Mabrig HealthOS
APP_NAME="Mabrig HealthOS"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=

# Database
DATABASE_URL=postgresql://naijamed:naijamed_secret@localhost:5432/naijamed_db

# AI / clinical agents
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
CLINICAL_LLM_MODEL=gemini-1.5-flash
CLINICAL_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Clinical RAG (pre-index approved Nigerian STG / WHO / locally reviewed protocols)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=healthos_clinical_protocols
RAG_SCORE_THRESHOLD=0.72

# PHI encryption: base64url or hex value that decodes to exactly 32 bytes
PHI_ENCRYPTION_KEY=
PHI_KEY_VERSION=v1

# Voice and low-bandwidth channels
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Maps / referral discovery
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Monetization
PAYSTACK_SECRET_KEY=
CONSULT_PLATFORM_FEE_PERCENT=18
FAMILY_PASS_MONTHLY_KOBO=500000
FAMILY_PASS_PAYSTACK_PLAN_CODE=
DOCTOR_WORKSPACE_MONTHLY_KOBO=1500000
DOCTOR_WORKSPACE_PAYSTACK_PLAN_CODE=

# Existing optional integrations
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
TERMII_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="NaijaMed AI"
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (Railway PostgreSQL / Neon / Supabase) ───────────────────────────
# Railway injects DATABASE_URL automatically when you attach a Postgres addon.
# For Neon/Supabase, copy the connection string from their dashboard.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── AI Keys ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Payments — Paystack (NGN) ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Payments — Flutterwave (NGN / African) ────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-xxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret

# ── Payments — Stripe (USD / EUR international) ───────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Logistics ─────────────────────────────────────────────────────────────────
SHIPMENT_WEBHOOK_SECRET=your-freight-partner-webhook-secret

# ── Email — SendGrid (primary) ────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ── Email — SMTP fallback (leave blank if using SendGrid) ────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-password

# ── SMS — Termii (Nigerian SMS gateway) ──────────────────────────────────────
TERMII_API_KEY=your-termii-api-key

# ── Currency conversion — exchangerate-api.com ───────────────────────────────
EXCHANGERATE_API_KEY=your-exchangerate-api-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# FRONTEND_URL: your primary Vercel production URL
FRONTEND_URL=https://your-app.vercel.app
# EXTRA_CORS_ORIGINS: comma-separated additional origins (e.g. Vercel preview URLs)
EXTRA_CORS_ORIGINS=

# ── Rate limiting ─────────────────────────────────────────────────────────────
AI_RATE_LIMIT=10/minute
EXPORT_AI_RATE_LIMIT=5/minute

# NigerFlora BioSciences — Vercel + MongoDB Atlas
APP_NAME="NigerFlora BioSciences"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAILS=

# Production domains
FRONTEND_URL=https://nigerflora.mabrigkorie.org
EXTRA_CORS_ORIGINS=https://nigerflora-biosciences.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mabrig_healthos

# Clinical agents
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
CLINICAL_LLM_MODEL=gemini-1.5-flash
CLINICAL_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=healthos_clinical_protocols
RAG_SCORE_THRESHOLD=0.72

# AES-256 PHI encryption: base64url or hex value decoding to exactly 32 bytes
PHI_ENCRYPTION_KEY=
PHI_KEY_VERSION=v1

# Voice + low-bandwidth channels
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Maps
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Monetization
PAYSTACK_SECRET_KEY=
CONSULT_PLATFORM_FEE_PERCENT=18
FAMILY_PASS_MONTHLY_KOBO=500000
FAMILY_PASS_PAYSTACK_PLAN_CODE=
DOCTOR_WORKSPACE_MONTHLY_KOBO=1500000
DOCTOR_WORKSPACE_PAYSTACK_PLAN_CODE=

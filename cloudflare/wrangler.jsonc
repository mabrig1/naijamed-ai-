{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "nigerflora-biosciences-preview",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

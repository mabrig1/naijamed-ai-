{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{backend/alembic/**,backend/app/models/**,backend/app/routers/**,backend/app/seeds/**,backend/app/services/**,backend/tests/**,frontend/**,shared/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/refills",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
